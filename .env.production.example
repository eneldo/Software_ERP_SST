# ============================================================
# ERP SST PRO - Variables de producción
# Copiar como .env.production y cambiar todos los secretos.
# ============================================================

POSTGRES_DB=erp_sst
POSTGRES_USER=erp_sst_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_SEGURO

DATABASE_URL=postgresql://erp_sst_user:CAMBIAR_PASSWORD_POSTGRES_SEGURO@db:5432/erp_sst
SECRET_KEY=CAMBIAR_SECRET_KEY_LARGO_MINIMO_64_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=erp_sst_refresh
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/auth

ENVIRONMENT=production
DEBUG=false
AUTO_CREATE_TABLES=false
DOCS_URL=
REDOC_URL=
OPENAPI_URL=

# Frontend público. En Docker interno puede quedar /api.
VITE_API_URL=/api
FRONTEND_PORT=8080
# Producción con Caddy o Nginx en el host: mantener solo en loopback.
FRONTEND_BIND=127.0.0.1

# CORS producción, separado por coma si hay más de uno.
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
TRUSTED_HOSTS=tu-dominio.com,www.tu-dominio.com
SECURITY_HEADERS_ENABLED=true
HTTPS_REDIRECT_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REDIS_PREFIX=erp_sst:rate_limit
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_REPORT_REQUESTS=10
RATE_LIMIT_PUBLIC_REPORT_WINDOW_SECONDS=3600
RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=300

UPLOAD_DIR=/app/app/uploads
LOG_DIR=/app/logs
