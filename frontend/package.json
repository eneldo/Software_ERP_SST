{
  "name": "sistema-gestion-sst-frontend",
  "private": true,
  "version": "1.6.1-hardening.36.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "lint": "eslint src",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist']) fs.rmSync(p,{recursive:true,force:true});\"",
    "build:clean": "npm run clean && npm run build",
    "check": "npm run lint && npm run build:clean",
    "preview:prod": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "vite": "^5.4.1"
  }
}
