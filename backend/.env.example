# ============================================================
# ERP SST PRO - VARIABLES DE ENTORNO
# FASE 36.2 — Limpieza y Seguridad Base Backend
# Copiar este archivo como .env y cambiar valores reales.
# Nunca subir .env a GitHub.
# ============================================================

APP_NAME="ERP SST PRO"
APP_VERSION="2.7.5-hardening-36.2"
ENVIRONMENT=development

DATABASE_URL=postgresql://usuario:password@localhost:5432/sst_erp

# Generar una llave segura de mínimo 32 caracteres.
SECRET_KEY=cambiar_esta_llave_por_una_segura_de_minimo_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Separar orígenes por coma, sin espacios obligatorios.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En desarrollo puede estar en true si aún no usa migraciones.
# En producción debe ser false.
AUTO_CREATE_TABLES=false

# Rutas de documentación. En producción puede dejarlas vacías si desea ocultarlas.
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

UPLOAD_DIR=app/uploads
UPLOAD_SUBDIRS=logos,firmas,documentos,evidencias,actas,capacitaciones,examenes-medicos,certificados,auditorias,inspecciones,reportes,medidas-correctivas

# ============================================================
# FASE 36.6 — Seguridad Enterprise
# ============================================================
TRUSTED_HOSTS=localhost,127.0.0.1
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.xlsx,.xls,.doc,.docx,.csv
